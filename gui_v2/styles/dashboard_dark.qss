}

QTabWidget#guiV2PlannerDiagnosticsPlotTabs::pane {
    border: 1px solid #344658;
    border-radius: 8px;
    background-color: #17212B;
    top: -1px;
}

QTabWidget#guiV2PlannerDiagnosticsPlotTabs QTabBar::tab {
    background-color: #17212B;
    color: #E5ECF3;
    border: 1px solid #344658;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 12px;
    margin-right: 3px;
}

QTabWidget#guiV2PlannerDiagnosticsPlotTabs QTabBar::tab:selected {
    background-color: #3473A5;
    color: #FFFFFF;
}

QTabWidget#guiV2PlannerDiagnosticsPlotTabs QTabBar::tab:hover {
    background-color: #2B3A49;
    color: #E5ECF3;
}

QLabel#guiV2DiagnosticsPlotDescription {
    color: #ABB8C6;
    font-size: 12px;
}


QTableView#guiV2PlannerDiagnosticsTable {
    background-color: #1D2935;
    alternate-background-color: #1D2935;
    color: #E5ECF3;
    border: 1px solid #344658;
    border-radius: 6px;
    gridline-color: #344658;
    selection-background-color: #3473A5;
    selection-color: #FFFFFF;
}

QTableView#guiV2PlannerDiagnosticsTable QHeaderView::section {
    background-color: #1D2935;
    color: #E5ECF3;
    border: 0;
    border-right: 1px solid #344658;
    border-bottom: 1px solid #344658;
    padding: 5px 7px;
    font-weight: 700;
}

QPlainTextEdit#guiV2PlannerDiagnosticsDetailsText {
    background-color: #1D2935;
    color: #E5ECF3;
    border: 1px solid #344658;
    border-radius: 6px;
    selection-background-color: #3473A5;
    selection-color: #FFFFFF;
    font-family: Consolas, 'Courier New', monospace;
    font-size: 12px;
}

QScrollArea#guiV2PlannerDiagnosticsScrollArea {
    background: transparent;
    border: none;
}


/* Task 58 shared component roles */
QWidget#guiV2Shell,
QStackedWidget#guiV2WorkspaceStack,
QWidget#guiV2WorkspaceGrid,
QWidget#guiV2PlannerDiagnosticsOverview,
QWidget#guiV2PlannerDiagnosticsDetailsContent,
QWidget#guiV2PlannerDiagnosticsPlotPage {
    background: transparent;
    color: #E5ECF3;
}

QTabWidget[visualRole="workspaceTabs"]::pane,
QTabWidget#guiV2PlannerDiagnosticsTabs::pane,
QTabWidget#guiV2PlannerDiagnosticsPlotTabs::pane,
QTabWidget#guiV2PlannerPreferencesTabs::pane {
    background: #17212B;
    border: 1px solid #344658;
    border-radius: 8px;
}

QTabBar::tab {
    background: #1D2935;
    color: #ABB8C6;
    border: 1px solid #344658;
    border-bottom: none;
    padding: 7px 12px;
    min-height: 18px;
}

QTabBar::tab:selected {
    background: #243240;
    color: #E5ECF3;
    border-color: #466078;
}

QTabBar::tab:hover:!selected {
    background: #2B3A49;
    color: #E5ECF3;
}

QAbstractItemView {
    background: #17212B;
    alternate-background-color: #1D2935;
    color: #E5ECF3;
    border: 1px solid #344658;
    gridline-color: #344658;
    selection-background-color: #3473A5;
    selection-color: #FFFFFF;
    outline: none;
}

QHeaderView::section {
    background: #243240;
    color: #E5ECF3;
    border: none;
    border-right: 1px solid #344658;
    border-bottom: 1px solid #344658;
    padding: 6px 8px;
    font-weight: 700;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QTableView:focus,
QTableWidget:focus,
QTreeWidget:focus,
QPushButton:focus {
    border: 2px solid #68A9D7;
}

QToolTip {
    background: #243240;
    color: #E5ECF3;
    border: 1px solid #466078;
    padding: 5px 7px;
}

QMenu {
    background: #243240;
    color: #E5ECF3;
    border: 1px solid #466078;
    padding: 4px;
}

QMenu::item {
    padding: 6px 18px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #3473A5;
    color: #FFFFFF;
}

QScrollBar:vertical {
    background: #17212B;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #466078;
    min-height: 28px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover { background: #68A9D7; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: transparent; height: 0; }

QScrollBar:horizontal {
    background: #17212B;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #466078;
    min-width: 28px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover { background: #68A9D7; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: transparent; width: 0; }

QLabel#guiV2PlannerLoadIndicator[loadState="idle"] { color: #8796A6; }
QLabel#guiV2PlannerLoadIndicator[loadState="loading"] { color: #D49A3A; }
QLabel#guiV2PlannerLoadIndicator[loadState="loaded"] { color: #2F7D5A; }
QLabel#guiV2PlannerLoadIndicator[loadState="error"] { color: #A83D49; }
QLabel#guiV2PlannerLoadIndicator[loadState="disabled"] { color: #6F7D8B; }

QWidget#guiV2LoadingOverlay {
    background: rgba(11, 17, 24, 178);
}
QFrame#guiV2LoadingPanel {
    background: #243240;
    border: 1px solid #466078;
    border-radius: 12px;
}
QLabel#guiV2LoadingMessage {
    color: #E5ECF3;
    font-size: 13px;
    font-weight: 650;
}
