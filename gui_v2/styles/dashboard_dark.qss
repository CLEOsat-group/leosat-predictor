    color: #E5ECF3;
    border: 1px solid #344658;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 12px;
    margin-right: 3px;
}

QTabWidget#guiV2PlannerDiagnosticsTabs QTabBar::tab:selected {
    background-color: #3473A5;
    color: #FFFFFF;
}

QTabWidget#guiV2PlannerDiagnosticsTabs QTabBar::tab:hover {
    background-color: #2B3A49;
