/* Generated from dashboard.qss.in; do not edit manually. */
/* gui-theme: light */
QMainWindow#guiRoot {
    background: #F1F4F7;
}

QWidget#guiCentral {
    background: #F1F4F7;
    color: #24303D;
    font-family: "Segoe UI", "Inter", "Arial", sans-serif;
    font-size: 12px;
}

QFrame#guiHeader {
    background: #FFFFFF;
    border: 1px solid #CBD5DF;
    border-radius: 12px;
}

QLabel#guiProductTitle {
    color: #24303D;
    font-size: 20px;
    font-weight: 700;
}

QLabel#guiContextLabel {
    color: #5A6877;
    font-size: 12px;
}

QFrame#guiHeaderStatusWidget {
    background: #FFFFFF;
    border: 1px solid #CBD5DF;
    border-radius: 10px;
}

QFrame#guiHeaderStatusWidget[level="ready"] {
    border-color: #CBD5DF;
}

QFrame#guiHeaderStatusWidget[level="info"] {
    border-color: #2E6F9F;
}

QFrame#guiHeaderStatusWidget[level="success"] {
    border-color: #257453;
}

QFrame#guiHeaderStatusWidget[level="warning"] {
    border-color: #8A5A0A;
}

QFrame#guiHeaderStatusWidget[level="error"] {
    border-color: #A8323E;
}

QFrame#guiHeaderStatusWidget[level="busy"] {
    border-color: #2E6F9F;
}

QLabel#guiHeaderStatusLevel {
    border-radius: 8px;
    padding: 3px 8px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.8px;
}

QLabel#guiHeaderStatusLevel[level="ready"] {
    background: #FFFFFF;
    color: #24303D;
}

QLabel#guiHeaderStatusLevel[level="info"] {
    background: #E4F0F8;
    color: #2E6F9F;
}

QLabel#guiHeaderStatusLevel[level="success"] {
    background: #E5F3EC;
    color: #257453;
}

QLabel#guiHeaderStatusLevel[level="warning"] {
    background: #FFF2D8;
    color: #8A5A0A;
}

QLabel#guiHeaderStatusLevel[level="error"] {
    background: #FBE7E9;
    color: #A8323E;
}

QLabel#guiHeaderStatusLevel[level="busy"] {
    background: #E4F0F8;
    color: #2E6F9F;
}

QLabel#guiHeaderStatusMessage {
    color: #24303D;
    font-weight: 600;
}


QWidget#guiNavigationRail {
    background: #FFFFFF;
    border: 1px solid #CBD5DF;
    border-radius: 12px;
}

QLabel#guiNavigationTitle {
    color: #667585;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QTreeWidget#guiNavigationTree,
QTreeWidget#guiNavigationBottomTree {
    background: transparent;
    border: none;
    color: #24303D;
    outline: none;
    padding: 4px;
}

QTreeWidget#guiNavigationTree::item,
QTreeWidget#guiNavigationBottomTree::item {
    min-height: 30px;
    padding: 4px 8px;
    border-radius: 8px;
}

QTreeWidget#guiNavigationTree::item:hover,
QTreeWidget#guiNavigationBottomTree::item:hover {
    background: #E3EBF2;
    color: #24303D;
}

QTreeWidget#guiNavigationTree::item:selected,
QTreeWidget#guiNavigationBottomTree::item:selected {
    background: #2E6F9F;
    color: #FFFFFF;
}

QFrame#guiNavigationSeparator {
    background: #CBD5DF;
    border: none;
}

QFrame#guiWorkspace {
    background: #FFFFFF;
    border: 1px solid #CBD5DF;
    border-radius: 12px;
}

QFrame#guiWorkspaceHeader {
    background: #F7F9FB;
    border: 1px solid #CBD5DF;
    border-radius: 10px;
}

QLabel#guiWorkspaceTitle {
    color: #24303D;
    font-size: 16px;
    font-weight: 700;
}

QLabel#guiWorkspaceSubtitle {
    color: #5A6877;
    font-size: 12px;
}


QLabel#guiWorkspaceStatusLine {
    color: #5A6877;
    font-size: 12px;
    padding: 0 4px 2px 4px;
}
QWidget#guiWorkspaceGrid {
    background: transparent;
}

QScrollArea#guiOverpassSetupScrollArea,
QWidget#guiOverpassSetupScrollContent,
QScrollArea#guiOverpassSetupScrollArea > QWidget > QWidget {
    background: transparent;
}

QFrame#guiCard {
    background: #F7F9FB;
    border: 1px solid #CBD5DF;
    border-radius: 12px;
}

QLabel#guiCardTitle {
    color: #24303D;
    font-size: 13px;
    font-weight: 700;
}

QLabel#guiCardBody {
    color: #5A6877;
    font-size: 12px;
}


QPushButton#guiNavigationToggle {
    background: #FFFFFF;
    color: #24303D;
    border: 1px solid #CBD5DF;
    border-radius: 9px;
    min-width: 34px;
    min-height: 30px;
    font-size: 16px;
    font-weight: 700;
}

QPushButton#guiNavigationToggle:hover {
    background: #E3EBF2;
    border-color: #AAB8C6;
}

QSplitter#guiMainSplitter::handle {
    background: #F1F4F7;
    border-radius: 3px;
}

QWidget#guiNavigationRail[compact="true"] {
    background: #FFFFFF;
}

QWidget#guiNavigationRail[compact="true"] QLabel#guiNavigationTitle {
    color: #667585;
}

QStackedWidget#guiNavigationModeStack {
    background: transparent;
    border: none;
}

QWidget#guiDomainRail {
    background: transparent;
}

QWidget#guiNavigationRail[railMode="true"] {
    background: #FFFFFF;
}

QPushButton#guiRailButton {
    background: #FFFFFF;
    color: #24303D;
    border: 1px solid #CBD5DF;
    border-radius: 10px;
    min-height: 38px;
    padding: 6px 10px;
    text-align: left;
    font-weight: 700;
}

QPushButton#guiRailButton:hover {
    background: #E3EBF2;
    border-color: #AAB8C6;
    color: #24303D;
}

QPushButton#guiRailButton[active="true"] {
    background: #2E6F9F;
    border-color: #2E6F9F;
    color: #FFFFFF;
}

QFrame#guiTimeContext {
    background: #FFFFFF;
    border: 1px solid #CBD5DF;
    border-radius: 10px;
}

QLabel#guiTimeContextKey {
    color: #24303D;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.7px;
}

QLabel#guiTimeContextValue {
    color: #24303D;
    font-family: "Cascadia Mono", "Consolas", "Courier New", monospace;
    font-size: 11px;
    font-weight: 600;
}


/* GUI generic form/control styling. Keep labels readable on dark cards. */
QLabel#guiFieldLabel {
    color: #24303D;
    font-size: 12px;
    font-weight: 600;
}

QFrame#guiCard QLabel {
    color: #24303D;
}

QFrame#guiCard QLabel#guiCardTitle {
    color: #24303D;
}

QFrame#guiCard QLabel#guiFieldLabel {
    color: #24303D;
}

QLineEdit, QDateEdit, QSpinBox, QComboBox, QListWidget, QPlainTextEdit {
    background: #F7F9FB;
    color: #24303D;
    border: 1px solid #CBD5DF;
    border-radius: 7px;
    padding: 5px 8px;
    selection-background-color: #2E6F9F;
    selection-color: #FFFFFF;
}

QLineEdit:read-only {
    background: #F7F9FB;
    color: #24303D;
}


QLineEdit[validationState="error"], QDateEdit[validationState="error"], QComboBox[validationState="error"], QListWidget[validationState="error"] {
    border-color: #A8323E;
}

QLineEdit[validationState="valid"], QDateEdit[validationState="valid"], QComboBox[validationState="valid"], QListWidget[validationState="valid"] {
    border-color: #CBD5DF;
}

QLineEdit:disabled, QDateEdit:disabled, QSpinBox:disabled, QComboBox:disabled, QListWidget:disabled, QPlainTextEdit:disabled {
    background: #EDF1F4;
    color: #7B8794;
    border-color: #CBD5DF;
}

QComboBox QAbstractItemView {
    background: #E9EEF3;
    color: #24303D;
    border: 1px solid #CBD5DF;
    selection-background-color: #2E6F9F;
    selection-color: #FFFFFF;
}

QCheckBox {
    color: #24303D;
    spacing: 7px;
}

QCheckBox:disabled {
    color: #7B8794;
}

QPushButton {
    background: #FFFFFF;
    color: #24303D;
    border: 1px solid #CBD5DF;
    border-radius: 7px;
    min-height: 22px;
    padding: 2px 8px;
    font-weight: 600;
}

QPushButton:hover {
    background: #E3EBF2;
    border-color: #AAB8C6;
}

QPushButton:disabled {
    background: #EDF1F4;
    color: #7B8794;
    border-color: #CBD5DF;
}

QPushButton[buttonRole="primary"]:enabled {
    background: #2E6F9F;
    border-color: #2E6F9F;
    color: #FFFFFF;
}

QPushButton[buttonRole="success"]:enabled {
    background: #257453;
    border-color: #257453;
    color: #FFFFFF;
}

QPushButton[buttonRole="danger"]:enabled {
    background: #A8323E;
    border-color: #A8323E;
    color: #FFFFFF;
}

QPushButton[buttonRole="secondary"]:enabled {
    background: #FFFFFF;
    border-color: #CBD5DF;
    color: #5A6877;
}

/* Role-button hover keeps each button's semantic hue and shifts its shade,
   instead of collapsing to the neutral gray surface (which read as the button
   losing its color) or leaving the state visually unchanged. */
QPushButton[buttonRole="primary"]:enabled:hover {
    background: #255D86;
    border-color: #255D86;
    color: #FFFFFF;
}

QPushButton[buttonRole="success"]:enabled:hover {
    background: #1E6146;
    border-color: #1E6146;
    color: #FFFFFF;
}

QPushButton[buttonRole="danger"]:enabled:hover {
    background: #8F2A35;
    border-color: #8F2A35;
    color: #FFFFFF;
}

QPushButton[buttonRole="secondary"]:enabled:hover {
    background: #E3EBF2;
    border-color: #AAB8C6;
    color: #24303D;
}

/* Planner form options: keep radio-button labels readable on dark backgrounds. */
QRadioButton {
    color: #24303D;
    spacing: 7px;
}

QRadioButton:disabled {
    color: #7B8794;
}

QFrame#guiPlannerStatusChip {
    background: #FFFFFF;
    border: 1px solid #CBD5DF;
    border-radius: 8px;
}

QFrame#guiPlannerStatusChip[ready="true"] {
    background: #FFFFFF;
    border-color: #CBD5DF;
}

QFrame#guiPlannerStatusChip[ready="true"] QLabel {
    color: #24303D;
}


QFrame#guiPlannerControlsSection {
    background: #FFFFFF;
    border: 1px solid #CBD5DF;
    border-radius: 10px;
}

QLabel#guiCompactCardTitle {
    color: #24303D;
    font-size: 12px;
    font-weight: 700;
}

QStackedWidget#guiPlannerBinningOptionStack,
QStackedWidget#guiPlannerBinningOptionStack QWidget {
    background: transparent;
}

/* GUI planner results workspace cards. */
QFrame#guiPlannerPlotWorkspace,
QFrame#guiPlannerGeneratedPlanWorkspace {
    background: #F7F9FB;
    border: 1px solid #CBD5DF;
    border-radius: 12px;
}

QFrame#guiPlannerPlotWorkspace QWidget,
QFrame#guiPlannerGeneratedPlanWorkspace QWidget {
    background: transparent;
    color: #24303D;
}

QFrame#guiPlannerPlotWorkspace QLabel#guiCardTitle,
QFrame#guiPlannerGeneratedPlanWorkspace QLabel#guiCardTitle {
    color: #24303D;
}

QFrame#guiPlannerPlotWorkspace QLabel#guiCardBody,
QFrame#guiPlannerGeneratedPlanWorkspace QLabel#guiCardBody {
    color: #5A6877;
}


QFrame#guiPlannerObservationInfoWorkspace {
    background: #F7F9FB;
    border: 1px solid #CBD5DF;
    border-radius: 12px;
}


QFrame#guiPlannerObservationInfoWorkspace QFrame#guiObservationDetailsFrame {
    background: #FFFFFF;
    border: 1px solid #CBD5DF;
    border-radius: 8px;
}

QFrame#guiPlannerObservationInfoWorkspace QWidget#guiObservationStartBlock {
    background: transparent;
}

QFrame#guiPlannerObservationInfoWorkspace QLabel {
    color: #5A6877;
}

QFrame#guiPlannerObservationInfoWorkspace QLabel#guiCardTitle {
    color: #24303D;
}

QFrame#guiPlannerObservationInfoWorkspace QLabel#guiObservationInfoSectionTitle {
    color: #24303D;
    font-size: 12px;
    font-weight: 700;
}

QFrame#guiPlannerObservationInfoWorkspace QLabel#guiObservationInfoName {
    color: #5A6877;
    font-size: 12px;
    font-weight: 600;
}

QFrame#guiPlannerObservationInfoWorkspace QLabel#guiObservationInfoValue {
    color: #24303D;
    font-size: 12px;
    font-weight: 600;
}

QFrame#guiPlannerObservationInfoWorkspace QLabel#guiObservationStartLabel {
    color: #24303D;
    font-size: 15px;
    font-weight: 700;
}

QFrame#guiPlannerObservationInfoWorkspace QLabel#observationStartTime {
    color: #24303D;
    font-size: 22px;
    font-weight: 700;
}

QFrame#guiPlannerObservationInfoWorkspace QLineEdit {
    background: #FFFFFF;
    color: #24303D;
    border: 1px solid #CBD5DF;
    border-radius: 7px;
    padding: 5px 8px;
}

QTableView#guiPlannerGeneratedPlanTable {
    background: #F7F9FB;
    alternate-background-color: #F7F9FB;
    color: #24303D;
    gridline-color: #CBD5DF;
    border: 1px solid #CBD5DF;
    border-radius: 6px;
    selection-background-color: #2E6F9F;
    selection-color: #FFFFFF;
}

QTableView#guiPlannerGeneratedPlanTable QHeaderView::section {
    background: #F7F9FB;
    color: #24303D;
    border: 0;
    border-right: 1px solid #CBD5DF;
    border-bottom: 1px solid #CBD5DF;
    padding: 4px 6px;
    font-weight: 600;
}

/* Planner result card action buttons. */
QWidget#guiPlannerGeneratedPlanActions QPushButton,
QFrame#guiPlannerObservationInfoWorkspace QPushButton {
    background: #FFFFFF;
    color: #24303D;
    border: 1px solid #CBD5DF;
    border-radius: 7px;
    min-height: 22px;
    padding: 2px 8px;
    font-weight: 600;
}

QWidget#guiPlannerGeneratedPlanActions QPushButton:hover,
QFrame#guiPlannerObservationInfoWorkspace QPushButton:hover {
    background: #E3EBF2;
    border-color: #AAB8C6;
    color: #24303D;
}

QWidget#guiPlannerGeneratedPlanActions QPushButton[buttonRole="primary"]:enabled {
    background: #2E6F9F;
    border-color: #2E6F9F;
    color: #FFFFFF;
}

QWidget#guiPlannerGeneratedPlanActions QPushButton[buttonRole="success"]:enabled {
    background: #257453;
    border-color: #257453;
    color: #FFFFFF;
}

QWidget#guiPlannerGeneratedPlanActions QPushButton[buttonRole="danger"]:enabled,
QFrame#guiPlannerObservationInfoWorkspace QPushButton[buttonRole="danger"]:enabled {
    background: #A8323E;
    border-color: #A8323E;
    color: #FFFFFF;
}

QWidget#guiPlannerGeneratedPlanActions QPushButton[buttonRole="primary"]:enabled:hover {
    background: #255D86;
    border-color: #255D86;
    color: #FFFFFF;
}

QWidget#guiPlannerGeneratedPlanActions QPushButton[buttonRole="success"]:enabled:hover {
    background: #1E6146;
    border-color: #1E6146;
    color: #FFFFFF;
}

QWidget#guiPlannerGeneratedPlanActions QPushButton[buttonRole="danger"]:enabled:hover,
QFrame#guiPlannerObservationInfoWorkspace QPushButton[buttonRole="danger"]:enabled:hover {
    background: #8F2A35;
    border-color: #8F2A35;
    color: #FFFFFF;
}

QWidget#guiPlannerGeneratedPlanActions QPushButton:disabled,
QFrame#guiPlannerObservationInfoWorkspace QPushButton:disabled {
    background: #EDF1F4;
    color: #7B8794;
    border-color: #CBD5DF;
}



/* Task 50A planner preferences editor: keep tab pages and column mapping on the GUI dark theme. */
QTabWidget#guiPlannerPreferencesTabs {
    background-color: #FFFFFF;
    color: #24303D;
    border: none;
}

QTabWidget#guiPlannerPreferencesTabs QStackedWidget {
    background-color: #FFFFFF;
    border: none;
}

QTabWidget#guiPlannerPreferencesTabs::pane {
    border: 1px solid #CBD5DF;
    border-radius: 8px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabWidget#guiPlannerPreferencesTabs::tab-bar {
    left: 0px;
    background-color: #FFFFFF;
}

QTabWidget#guiPlannerPreferencesTabs QTabBar {
    background-color: #FFFFFF;
    color: #24303D;
    qproperty-drawBase: 0;
}

QTabWidget#guiPlannerPreferencesTabs QTabBar::tab {
    background-color: #FFFFFF;
    color: #24303D;
    border: 1px solid #CBD5DF;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 12px;
    margin-right: 3px;
}

QTabWidget#guiPlannerPreferencesTabs QTabBar::tab:selected {
    background-color: #2E6F9F;
    color: #FFFFFF;
}

QTabWidget#guiPlannerPreferencesTabs QTabBar::tab:hover {
    background-color: #E3EBF2;
    color: #24303D;
}

QScrollArea#guiPlannerPreferencesGeneralTab,
QScrollArea#guiPlannerPreferencesDiagnosticsTab,
QScrollArea#guiPlannerPreferencesColumnsTab,
QWidget#guiPlannerPreferencesGeneralTabContent,
QWidget#guiPlannerPreferencesDiagnosticsTabContent,
QWidget#guiPlannerPreferencesColumnsTabContent,
QScrollArea#guiPlannerPreferencesGeneralTab > QWidget > QWidget,
QScrollArea#guiPlannerPreferencesDiagnosticsTab > QWidget > QWidget,
QScrollArea#guiPlannerPreferencesColumnsTab > QWidget > QWidget {
    background-color: #FFFFFF;
    border: none;
}

QTableWidget#guiPlannerColumnMappingTable {
    background-color: #F7F9FB;
    alternate-background-color: #F7F9FB;
    color: #24303D;
    border: 1px solid #CBD5DF;
    border-radius: 6px;
    gridline-color: #CBD5DF;
    selection-background-color: #2E6F9F;
    selection-color: #FFFFFF;
}

QTableWidget#guiPlannerColumnMappingTable::item {
    background-color: transparent;
    color: #24303D;
    padding: 4px 6px;
}

QTableWidget#guiPlannerColumnMappingTable::item:selected {
    background-color: #2E6F9F;
    color: #FFFFFF;
}

QTableWidget#guiPlannerColumnMappingTable QHeaderView::section {
    background-color: #F7F9FB;
    color: #24303D;
    border: 0;
    border-right: 1px solid #CBD5DF;
    border-bottom: 1px solid #CBD5DF;
    padding: 5px 7px;
    font-weight: 700;
}

QTableWidget#guiPlannerColumnMappingTable QTableCornerButton::section {
    background-color: #F7F9FB;
    border: 0;
    border-right: 1px solid #CBD5DF;
    border-bottom: 1px solid #CBD5DF;
}

QTableWidget#guiPlannerColumnMappingTable QSpinBox {
    background-color: #F7F9FB;
    color: #24303D;
    border: 1px solid #CBD5DF;
    border-radius: 6px;
    padding: 3px 6px;
}

/* Task 48E planner diagnostics workspace */
QWidget#guiPlannerDiagnosticsWorkspace {
    background: transparent;
}

QWidget#guiPlannerDiagnosticsOverview,
QWidget#guiPlannerDiagnosticsDetailsContent,
QWidget#guiPlannerDiagnosticsPlotPage,
QScrollArea#guiPlannerDiagnosticsScrollArea QWidget {
    background-color: #FFFFFF;
}

QFrame#guiDiagnosticsSummaryStrip,
QFrame#guiDiagnosticsCard {
    background-color: #F7F9FB;
    border: 1px solid #CBD5DF;
    border-radius: 8px;
}

QLabel#guiDiagnosticsCardTitle,
QLabel#guiDiagnosticsTableTitle,
QLabel#guiDiagnosticsPlotTitle {
    color: #24303D;
    font-size: 13px;
    font-weight: 700;
}

QLabel#guiDiagnosticsCardBody {
    color: #5A6877;
    font-size: 12px;
}

QTabWidget#guiPlannerDiagnosticsTabs::pane {
    border: 1px solid #CBD5DF;
    border-radius: 8px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabWidget#guiPlannerDiagnosticsTabs QTabBar::tab {
    background-color: #FFFFFF;
    color: #24303D;
    border: 1px solid #CBD5DF;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 12px;
    margin-right: 3px;
}

QTabWidget#guiPlannerDiagnosticsTabs QTabBar::tab:selected {
    background-color: #2E6F9F;
    color: #FFFFFF;
}

QTabWidget#guiPlannerDiagnosticsTabs QTabBar::tab:hover {
    background-color: #E3EBF2;
    color: #24303D;
}

QTabWidget#guiPlannerDiagnosticsPlotTabs::pane {
    border: 1px solid #CBD5DF;
    border-radius: 8px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabWidget#guiPlannerDiagnosticsPlotTabs QTabBar::tab {
    background-color: #FFFFFF;
    color: #24303D;
    border: 1px solid #CBD5DF;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 12px;
    margin-right: 3px;
}

QTabWidget#guiPlannerDiagnosticsPlotTabs QTabBar::tab:selected {
    background-color: #2E6F9F;
    color: #FFFFFF;
}

QTabWidget#guiPlannerDiagnosticsPlotTabs QTabBar::tab:hover {
    background-color: #E3EBF2;
    color: #24303D;
}

QLabel#guiDiagnosticsPlotDescription {
    color: #5A6877;
    font-size: 12px;
}


QTableView#guiPlannerDiagnosticsTable {
    background-color: #F7F9FB;
    alternate-background-color: #F7F9FB;
    color: #24303D;
    border: 1px solid #CBD5DF;
    border-radius: 6px;
    gridline-color: #CBD5DF;
    selection-background-color: #2E6F9F;
    selection-color: #FFFFFF;
}

QTableView#guiPlannerDiagnosticsTable QHeaderView::section {
    background-color: #F7F9FB;
    color: #24303D;
    border: 0;
    border-right: 1px solid #CBD5DF;
    border-bottom: 1px solid #CBD5DF;
    padding: 5px 7px;
    font-weight: 700;
}

QPlainTextEdit#guiPlannerDiagnosticsDetailsText {
    background-color: #F7F9FB;
    color: #24303D;
    border: 1px solid #CBD5DF;
    border-radius: 6px;
    selection-background-color: #2E6F9F;
    selection-color: #FFFFFF;
    font-family: Consolas, 'Courier New', monospace;
    font-size: 12px;
}

QScrollArea#guiPlannerDiagnosticsScrollArea {
    background: transparent;
    border: none;
}


/* Task 58 shared component roles */
QWidget#guiShell,
QStackedWidget#guiWorkspaceStack,
QWidget#guiWorkspaceGrid,
QWidget#guiPlannerDiagnosticsOverview,
QWidget#guiPlannerDiagnosticsDetailsContent,
QWidget#guiPlannerDiagnosticsPlotPage {
    background: transparent;
    color: #24303D;
}

QTabWidget[visualRole="workspaceTabs"]::pane,
QTabWidget#guiPlannerDiagnosticsTabs::pane,
QTabWidget#guiPlannerDiagnosticsPlotTabs::pane,
QTabWidget#guiPlannerPreferencesTabs::pane {
    background: #FFFFFF;
    border: 1px solid #CBD5DF;
    border-radius: 8px;
}

QTabBar::tab {
    background: #F7F9FB;
    color: #5A6877;
    border: 1px solid #CBD5DF;
    border-bottom: none;
    padding: 7px 12px;
    min-height: 18px;
}

QTabBar::tab:selected {
    background: #E9EEF3;
    color: #24303D;
    border-color: #AAB8C6;
}

QTabBar::tab:hover:!selected {
    background: #E3EBF2;
    color: #24303D;
}

QAbstractItemView {
    background: #FFFFFF;
    alternate-background-color: #F7F9FB;
    color: #24303D;
    border: 1px solid #CBD5DF;
    gridline-color: #CBD5DF;
    selection-background-color: #2E6F9F;
    selection-color: #FFFFFF;
    outline: none;
}

QHeaderView::section {
    background: #E9EEF3;
    color: #24303D;
    border: none;
    border-right: 1px solid #CBD5DF;
    border-bottom: 1px solid #CBD5DF;
    padding: 6px 8px;
    font-weight: 700;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QTableView:focus,
QTableWidget:focus,
QTreeWidget:focus,
QPushButton:focus {
    border: 2px solid #2E7FB8;
}

QToolTip {
    background: #E9EEF3;
    color: #24303D;
    border: 1px solid #AAB8C6;
    padding: 5px 7px;
}

QMenu {
    background: #E9EEF3;
    color: #24303D;
    border: 1px solid #AAB8C6;
    padding: 4px;
}

QMenu::item {
    padding: 6px 18px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #2E6F9F;
    color: #FFFFFF;
}

QScrollBar:vertical {
    background: #FFFFFF;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #AAB8C6;
    min-height: 28px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover { background: #2E7FB8; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: transparent; height: 0; }

QScrollBar:horizontal {
    background: #FFFFFF;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #AAB8C6;
    min-width: 28px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover { background: #2E7FB8; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: transparent; width: 0; }

QLabel#guiPlannerLoadIndicator[loadState="idle"] { color: #667585; }
QLabel#guiPlannerLoadIndicator[loadState="loading"] { color: #8A5A0A; }
QLabel#guiPlannerLoadIndicator[loadState="loaded"] { color: #257453; }
QLabel#guiPlannerLoadIndicator[loadState="error"] { color: #A8323E; }
QLabel#guiPlannerLoadIndicator[loadState="disabled"] { color: #7B8794; }

QWidget#guiLoadingOverlay {
    background: rgba(36, 48, 61, 76);
}
QFrame#guiLoadingPanel {
    background: #E9EEF3;
    border: 1px solid #AAB8C6;
    border-radius: 12px;
}
QLabel#guiLoadingMessage {
    color: #24303D;
    font-size: 13px;
    font-weight: 650;
}
