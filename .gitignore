# Task 57B generated PyInstaller output
/build/
/dist/

# Python bytecode / caches
__pycache__/
*.pyc
*.pyo

# Editable-install metadata
*.egg-info/

# JetBrains project state that drifts locally
.idea/*.iml
.idea/misc.xml
.idea/csv-editor.xml

# Runtime / user state (see data/*.example.json for shipped templates)
/data/user_locations.json
/data/user_preferences.json

