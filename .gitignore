/visible_*.csv
/visible_*_tle.txt
/leosat_obs_plan_*.csv
/leosat_obs_plan_*.json
/leosat_obs_plan_*_diagnostics.json

# Generated documentation output
docs/manual/gui_user_manual.pdf

# Local development TLS certificates (self-signed; generate per machine)
/certs/*.key
/certs/*.crt
/certs/*.pem
