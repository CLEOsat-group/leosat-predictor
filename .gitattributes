# Normalize line endings: check out with the platform's native EOL,
# store LF in the repository. Keeps diffs clean across Windows/macOS/Linux.
* text=auto

# Scripts that must retain a specific line ending regardless of platform
*.ps1   text eol=crlf
*.sh    text eol=lf

# Treat these as binary (no EOL normalization, no diff)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.db    binary
*.crt   binary
*.key   binary
*.pem   binary
